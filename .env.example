# Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Superadmin Telegram IDs — always have full access, cannot be removed via bot or web panel
# Comma-separated. Get your ID by writing any message to the bot before being added as admin.
SUPERADMIN_IDS=123456789,987654321

# Web admin panel password
ADMIN_PASSWORD=changeme_strong_password

# Secret key for session cookies (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_random_64_char_string

# Database path (SQLite mounted as Docker volume)
DATABASE_URL=sqlite:////data/db.sqlite3
